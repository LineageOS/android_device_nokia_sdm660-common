+        ClientRegisterReq(LocationClientApiImpl& apiImpl) : mApiImpl(apiImpl) {}
+        void proc() const {
+            string pbStr;
+            LocAPIClientRegisterReqMsg msg(mApiImpl.mSocketName, LOCATION_CLIENT_API,
+                    &mApiImpl.mPbufMsgConv);
