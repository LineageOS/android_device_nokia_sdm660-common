+
+    // float pdop = 4;
+    // float hdop = 5;
+    // float vdop = 6;
+    // float gdop = 7;
+    // float tdop = 8;
+    // float magneticDeviation = 9;
+    pbGnssLocInfoNotif->set_pdop(gnssLocInfoNotif.pdop);
+    pbGnssLocInfoNotif->set_hdop(gnssLocInfoNotif.hdop);
+    pbGnssLocInfoNotif->set_vdop(gnssLocInfoNotif.vdop);
