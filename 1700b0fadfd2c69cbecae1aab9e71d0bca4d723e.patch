+          if (GNSS_AIDING_DATA_SV_IONOSPHERE_BIT & data.sv.svMask) {
+              delete_gnss_req.deleteSatelliteData_valid = 1;
+              delete_gnss_req.deleteSatelliteData.deleteSatelliteDataMask |=
