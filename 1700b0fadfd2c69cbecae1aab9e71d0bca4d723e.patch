+    // double driftNsps = 8;
+    pbGnssMeasClock->set_driftnsps(gnssMeasClock.driftNsps);
+    // double driftUncertaintyNsps = 9;
+    pbGnssMeasClock->set_driftuncertaintynsps(gnssMeasClock.driftUncertaintyNsps);
