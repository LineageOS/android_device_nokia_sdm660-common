+            rtv = sllReqIf->sllStartFix(posMode, ((void *)this));
+            if (LOC_API_ADAPTER_ERR_SUCCESS == rtv) {
+                err = LOCATION_ERROR_SUCCESS;
+            }
+        } else {
+            err = LOCATION_ERROR_NOT_SUPPORTED;
+        }
+        if (adapterResponse != NULL) {
+            adapterResponse->returnToSender(err);
+        }
+    }));
