+    loc_sess_status status = LOC_SESS_FAILURE;
+    if (pbStatus == PB_LOCATION_SESS_SUCCESS) {
+        status = LOC_SESS_SUCCESS;
+    } else if (pbStatus == PB_LOCATION_SESS_INTERMEDIATE) {
+        status = LOC_SESS_INTERMEDIATE;
+    }
+    return status;
+}
