+    if (::GNSS_SYSTEM_TIME_WEEK_VALID & halGnssTime.validityMask) {
+        gnssTimeFlags |= GNSS_SYSTEM_TIME_WEEK_VALID;
+        gnssTime.systemWeek = halGnssTime.systemWeek;
