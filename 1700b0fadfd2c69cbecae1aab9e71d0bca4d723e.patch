+
+        stopOutdoorTripBatchingSync(false);
+
+        err = startOutdoorTripBatchingSync(ongoingTripDistance,
+                                           ongoingTripInterval,
+                                           batchingTimeout);
+        if (adapterResponse != NULL) {
+            adapterResponse->returnToSender(err);
+        }
+    }));
+}
