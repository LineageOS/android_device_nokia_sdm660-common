+    /** Uncertainty of Side-ward Acceleration in body frame */
+    float           latAccelUnc;
+    /** Uncertainty of Vertical Acceleration in body frame */
+    float           vertAccelUnc;
+    /** Uncertainty of Heading Rate */
+    float           yawRateUnc;
+    /** Uncertainty of Body pitch */
