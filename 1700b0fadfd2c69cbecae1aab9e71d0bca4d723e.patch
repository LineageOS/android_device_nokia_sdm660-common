+                    halLocationInfo.measUsageInfo[idx].gnssConstellation;
+            measUsageInfo.gnssSvId = halLocationInfo.measUsageInfo[idx].gnssSvId;
+            clientMeasUsageInfo.push_back(measUsageInfo);
