+    PB_GEOFENCE_BREACH_ENTER_BIT     = 1;
+    PB_GEOFENCE_BREACH_EXIT_BIT      = 2;
+    PB_GEOFENCE_BREACH_DWELL_IN_BIT  = 4;
+    PB_GEOFENCE_BREACH_DWELL_OUT_BIT = 8;
+}
