+
+        @return false, if request is not successfully processed as
+                requested. When returning false, LocConfigCb() will
+                not be invoked. <br/>
+    */
+    bool configConstellations(const LocConfigBlacklistedSvIdList*
+                              blacklistedSvList=nullptr);
+
