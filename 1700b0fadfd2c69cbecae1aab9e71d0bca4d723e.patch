+    PB_LOCATION_CAPS_QWES_QDR2                         = 65536;
+    /** This mask indicates QDR3_C license bundle is enabled.
+     *  This bundle includes features for SV Polynomial. <br/> */
+    PB_LOCATION_CAPS_QWES_QDR3                         = 131072;
+}
